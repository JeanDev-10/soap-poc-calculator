<?xml version="1.0" encoding="UTF-8"?>
<definitions name="LibraryService"
    targetNamespace="http://devnova.com/library"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="http://devnova.com/library"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <types>
    <xs:schema targetNamespace="http://devnova.com/library" elementFormDefault="qualified">
      <!-- Tipo complejo reutilizable -->
      <xs:complexType name="Book">
        <xs:sequence>
          <xs:element name="id" type="xs:int"/>
          <xs:element name="title" type="xs:string"/>
          <xs:element name="author" type="xs:string"/>
          <xs:element name="year" type="xs:int" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>

      <!-- Header de autenticación -->
      <xs:element name="Token" type="xs:string"/>

      <xs:element name="CreateBookRequest">
        <xs:complexType><xs:sequence>
          <xs:element name="title" type="xs:string"/>
          <xs:element name="author" type="xs:string"/>
          <xs:element name="year" type="xs:int" minOccurs="0"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="CreateBookResponse">
        <xs:complexType><xs:sequence>
          <xs:element name="book" type="tns:Book"/>
        </xs:sequence></xs:complexType>
      </xs:element>

      <xs:element name="GetBookRequest">
        <xs:complexType><xs:sequence>
          <xs:element name="id" type="xs:int"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="GetBookResponse">
        <xs:complexType><xs:sequence>
          <xs:element name="book" type="tns:Book"/>
        </xs:sequence></xs:complexType>
      </xs:element>

      <xs:element name="ListBooksRequest">
        <xs:complexType><xs:sequence/></xs:complexType>
      </xs:element>
      <xs:element name="ListBooksResponse">
        <xs:complexType><xs:sequence>
          <xs:element name="book" type="tns:Book" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>

      <xs:element name="UpdateBookRequest">
        <xs:complexType><xs:sequence>
          <xs:element name="id" type="xs:int"/>
          <xs:element name="title" type="xs:string"/>
          <xs:element name="author" type="xs:string"/>
          <xs:element name="year" type="xs:int" minOccurs="0"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="UpdateBookResponse">
        <xs:complexType><xs:sequence>
          <xs:element name="book" type="tns:Book"/>
        </xs:sequence></xs:complexType>
      </xs:element>

      <xs:element name="DeleteBookRequest">
        <xs:complexType><xs:sequence>
          <xs:element name="id" type="xs:int"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="DeleteBookResponse">
        <xs:complexType><xs:sequence>
          <xs:element name="deleted" type="xs:boolean"/>
        </xs:sequence></xs:complexType>
      </xs:element>
    </xs:schema>
  </types>

  <message name="TokenHeader"><part name="token" element="tns:Token"/></message>

  <message name="CreateBookIn"><part name="parameters" element="tns:CreateBookRequest"/></message>
  <message name="CreateBookOut"><part name="parameters" element="tns:CreateBookResponse"/></message>
  <message name="GetBookIn"><part name="parameters" element="tns:GetBookRequest"/></message>
  <message name="GetBookOut"><part name="parameters" element="tns:GetBookResponse"/></message>
  <message name="ListBooksIn"><part name="parameters" element="tns:ListBooksRequest"/></message>
  <message name="ListBooksOut"><part name="parameters" element="tns:ListBooksResponse"/></message>
  <message name="UpdateBookIn"><part name="parameters" element="tns:UpdateBookRequest"/></message>
  <message name="UpdateBookOut"><part name="parameters" element="tns:UpdateBookResponse"/></message>
  <message name="DeleteBookIn"><part name="parameters" element="tns:DeleteBookRequest"/></message>
  <message name="DeleteBookOut"><part name="parameters" element="tns:DeleteBookResponse"/></message>

  <portType name="LibraryPortType">
    <operation name="CreateBook"><input message="tns:CreateBookIn"/><output message="tns:CreateBookOut"/></operation>
    <operation name="GetBook"><input message="tns:GetBookIn"/><output message="tns:GetBookOut"/></operation>
    <operation name="ListBooks"><input message="tns:ListBooksIn"/><output message="tns:ListBooksOut"/></operation>
    <operation name="UpdateBook"><input message="tns:UpdateBookIn"/><output message="tns:UpdateBookOut"/></operation>
    <operation name="DeleteBook"><input message="tns:DeleteBookIn"/><output message="tns:DeleteBookOut"/></operation>
  </portType>

  <binding name="LibraryBinding" type="tns:LibraryPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="CreateBook">
      <soap:operation soapAction="http://devnova.com/library/CreateBook"/>
      <input><soap:body use="literal"/><soap:header message="tns:TokenHeader" part="token" use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="GetBook">
      <soap:operation soapAction="http://devnova.com/library/GetBook"/>
      <input><soap:body use="literal"/><soap:header message="tns:TokenHeader" part="token" use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="ListBooks">
      <soap:operation soapAction="http://devnova.com/library/ListBooks"/>
      <input><soap:body use="literal"/><soap:header message="tns:TokenHeader" part="token" use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="UpdateBook">
      <soap:operation soapAction="http://devnova.com/library/UpdateBook"/>
      <input><soap:body use="literal"/><soap:header message="tns:TokenHeader" part="token" use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="DeleteBook">
      <soap:operation soapAction="http://devnova.com/library/DeleteBook"/>
      <input><soap:body use="literal"/><soap:header message="tns:TokenHeader" part="token" use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <service name="LibraryService">
    <port name="LibraryPort" binding="tns:LibraryBinding">
      <soap:address location="http://localhost:8001/library"/>
    </port>
  </service>
</definitions>
